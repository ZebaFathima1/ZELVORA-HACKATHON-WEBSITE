SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
AI_WORKER_SECRET=GENERATE_A_LONG_RANDOM_SECRET_AND_SET_THE_SAME_VALUE_IN_SUPABASE
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b
OLLAMA_TIMEOUT_MS=900000
OLLAMA_KEEP_ALIVE=10m
WORKER_DISPLAY_NAME=Zelvora Windows Worker

# Supabase Edge Function secret (not used by this worker process):
# ALLOWED_ORIGIN=http://localhost:3000,http://localhost:3001,https://YOUR_PRODUCTION_DOMAIN
